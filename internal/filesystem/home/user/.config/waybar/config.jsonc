{

"layer": "top",
"position": "top",
"exclusive": true,
"focusable": false,
"margin-bottom": 0,
"margin-top": 10,

"modules-left": ["cpu", "battery", "custom/recording"],
"modules-center": ["wlr/taskbar", "hyprland/workspaces", "group/center-icons", "tray"],
"modules-right": ["clock"],

// Left

"cpu": {
    "format": "●",
    "interval": 5,
    "states": {
        "low": 10,
        "medium": 20,
        "high": 35,
        "very_high": 55,
        "extremely_high": 70
    },
    "tooltip": false,
    "on-click": "pkill -x resources || resources"
},

"custom/recording": {
    "exec": "pgrep wf-recorder > /dev/null && echo '●' || echo ''",
    "interval": "once",
    "signal": 1,
    "tooltip": false
},

"battery": {
    "format": "\uf1e6 {icon} {capacity}%",
    "format-charging": "\uf0e7 {icon} {capacity}%",
    "format-discharging": "{icon} {capacity}%",
    "tooltip": false,
    "format-icons": ["\uf244", "\uf243", "\uf242", "\uf241", "\uf240"],
    "on-click": "pkill -f $HOME/.config/waybar/charge-limit.sh || $HOME/.config/waybar/charge-limit.sh"
},

"tray": {
    "icon-size": 16
},

// Center

"wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 16,
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-middle": "close",
    "ignore-list": ["rzes.adwifi", "com.saivert.pwvucontrol", "com.ezratweaver.AdwBluetooth", "yad.power", "zenity", "clipse", "unicode-input", "polkit-gnome-authentication-agent-1", "yad.charge", "yad.calendar", "dummy-window"]
},

"hyprland/workspaces": {
    "all-outputs": true,
    "on-scroll-up": "flock -n /tmp/waybar_workspace.lock sh -c 'hyprctl dispatch \"hl.dsp.focus({ workspace = \\\"r-1\\\" })\" && sleep 0.1'",
    "on-scroll-down": "flock -n /tmp/waybar_workspace.lock sh -c 'hyprctl dispatch \"hl.dsp.focus({ workspace = \\\"r+1\\\" })\" && sleep 0.1'",
    "on-click-right-release": "hyprctl eval 'hl.plugin.hyprexpo.expo(\"toggle\")'"
},

"group/center-icons": {
    "orientation": "horizontal",
    "modules": [
        "custom/launcher",
        // "custom/overview",
        "custom/power",
        "idle_inhibitor",
        "pulseaudio",
        "network",
        "bluetooth"
    ]
},

"custom/launcher": {
    "format": "\uf002",
    "on-click": "rofi -show drun",
    "tooltip": false
},

"custom/overview": {
    "format": "\uf14e",
    "on-click": "",
    "on-click-release": "~/.config/hypr/scripts/toggle_overview.sh",
    "tooltip": false
},

"custom/power": {
    "format": "\uf011",
    "on-click": "pkill -9 -f '^yad --name=yad.power' || (pkill adwifi; pkill adw-bluetooth; pkill pwvucontrol; \"$HOME/.config/waybar/power.sh\")",
    "tooltip": false
},

"idle_inhibitor": {
    "format": "\uf254",
    "tooltip": false
},

"pulseaudio": {
    "format": "\uf028",
    "tooltip-format": "{desc} ({volume}%)",
    "on-click": "pkill pwvucontrol || (pkill -f \"$HOME/.config/waybar/power.sh\"; pkill adwifi; pkill adw-bluetooth; pwvucontrol)"
},

"network": {
    "format": "\uf1eb",
    "tooltip-format": "Connected to {essid}",
    "tooltip-format-disabled": "Wi-Fi disabled",
    "tooltip-format-disconnected": "Wi-Fi not connected",
    "on-click": "pkill adwifi || (pkill -f \"$HOME/.config/waybar/power.sh\"; pkill pwvucontrol; pkill adw-bluetooth; adwifi)"
},

"bluetooth": {
    "format": "\uf294",
    "tooltip-format": "Bluetooth not connected",
    "tooltip-format-disabled": "Bluetooth disabled",
    "tooltip-format-off": "Bluetooth disabled",
    "tooltip-format-connected": "Connected to {device_alias}",
    "on-click": "pkill adw-bluetooth || (pkill -f \"$HOME/.config/waybar/power.sh\"; pkill pwvucontrol; pkill adwifi; adw-bluetooth)"
},

"custom/left": {
    "format": "\uf060",
    "tooltip": false,
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"r-1\" })'"
},

"custom/right": {
    "format": "\uf061",
    "tooltip": false,
    "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"r+1\" })'"
},

// Right

"clock": {
    "format": "{:%a %d %b · %H : %M}",
    "tooltip": false,
    "on-click": "pkill -f '^yad --name=yad.calendar' || yad --name=yad.calendar --calendar --no-buttons"
}

}
